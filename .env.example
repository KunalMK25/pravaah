# PRAVAAH — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.

# ── Weather (Optional — application works without this) ──────────────────────
# Get a free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── LLM / Agentic AI (Optional — rule-based fallback if not set) ─────────────
# Set to "openai", "anthropic", "groq" (or leave as "none" to disable LLM)
PRAVAAH_LLM_PROVIDER=none

# If PRAVAAH_LLM_PROVIDER=openai:
OPENAI_API_KEY=your_openai_api_key_here
PRAVAAH_OPENAI_MODEL=gpt-4o-mini

# If PRAVAAH_LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PRAVAAH_ANTHROPIC_MODEL=claude-3-haiku-20240307

# If PRAVAAH_LLM_PROVIDER=groq:
GROQ_API_KEY=your_groq_api_key_here
PRAVAAH_GROQ_MODEL=llama3-8b-8192

# ── Cache directories (Optional — defaults used if not set) ──────────────────
PRAVAAH_WEATHER_CACHE_DIR=data/cache/weather

# ── Google Maps (Optional — OpenStreetMap used by default) ───────────────────
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
